# For a native binary installed by hand, outside any package manager — ExecStart below points at
# /usr/local/bin, the real FHS location for software not managed by the distribution's package
# manager. A package that installs the binary somewhere else (AUR installs to /usr/bin, matching
# real Arch convention for anything managed by pacman) needs its own copy of this unit with a
# matching ExecStart, not this one verbatim — see packaging/aur/terrustia.service and its PKGBUILD's
# own header comment for why the two used to disagree and no longer do.
[Unit]
Description=terrustia, a Terraria server
Documentation=https://github.com/bybrooklyn/terrustia
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=terrustia
Group=terrustia
WorkingDirectory=/var/lib/terrustia
ExecStart=/usr/local/bin/terrustia --config /etc/terrustia/terrustia.toml

# The server exits non-zero when it crashes and zero when it is asked to stop, so this restarts
# after a fault and stays down after `systemctl stop`. A rollback is the deliberate exception: it
# exits 75 so the restored world is loaded by a fresh process, because the running one has already
# dropped its save path. The crash distinction only started working when the panic path was fixed;
# before it, a crashed server exited 0 and was never restarted.
Restart=on-failure
RestartSec=5s

# The shutdown save has to finish. SIGTERM is what the server listens for; the default 90 seconds
# is far longer than a save needs even on a large world, and cutting it short loses the difference
# between the last autosave and now.
KillSignal=SIGTERM
TimeoutStopSec=90

# Logs go to the journal. The server writes plain lines to stdout, so `journalctl -u terrustia`
# reads the way the terminal does.
StandardOutput=journal
StandardError=journal

# It needs a network socket and one directory. Everything else is closed off.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

ReadWritePaths=/var/lib/terrustia
StateDirectory=terrustia

[Install]
WantedBy=multi-user.target
